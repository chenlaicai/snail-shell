{
  "_help": "复制本文件为 config/feishu.json 后再填写。config/feishu.json 会被 git 忽略，不要提交真实 app secret 或 chat 配置。",
  "_enabled_help": "是否启用飞书接入。false 表示完全不启动飞书长连接；配置好飞书应用凭据和 allowed_chats 后改为 true。",
  "enabled": false,
  "_app_id_help": "飞书企业自建应用的 App ID，形如 cli_xxx。",
  "app_id": "",
  "_app_secret_help": "飞书企业自建应用的 App Secret。",
  "app_secret": "",
  "_allowed_chats_help": "允许接入大厅的飞书群白名单。每个条目只声明 chat_id（及可选 tenant_key）；一个飞书群 = 一个独立的大厅会话，不需要绑定 conversation_id。",
  "allowed_chats": [
    {
      "_tenant_key_help": "飞书租户标识。多租户或需要租户隔离时填写事件里的 tenant_key；单租户本地使用可以留空，留空时只按 chat_id 匹配。",
      "tenant_key": "",
      "_chat_id_help": "飞书群聊的 chat_id，来自飞书 im.message.receive_v1 事件 message.chat_id。只有白名单中的群消息会进入大厅。",
      "chat_id": ""
    }
  ],
  "_message_push_help": "Snail Shell 回复推回飞书的控制项。当前只推送可见文本和 content_block，不推送工具日志、密钥或本地配置。",
  "message_push": {
    "_max_text_length_help": "单条推送到飞书的最大文本长度，超过会截断。建议不要超过飞书文本消息限制；默认 4000。",
    "max_text_length": 4000
  }
}
