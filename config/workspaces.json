{
  "workspaces": [
    {
      "id": "snail-shell",
      "module": "workspace_management",
      "name": "Snail Shell",
      "summary": "用于迭代 Snail Shell 自身的默认工作区。",
      "workspace_root": "{{process.cwd()}}",
      "guard_profile": null,
      "sop_bindings": [
        {
          "sop_id": "sop-code-delivery",
          "is_default": true,
          "role_bindings": {
            "designer": "claude-code-opus-4-7",
            "developer": "claude-code-opus-4-7",
            "reviewer": [
              "codex-gpt-5-5",
              "gpt-5-5"
            ],
            "merger": "codex-gpt-5-5"
          }
        }
      ]
    },
    {
      "id": "evolution-center",
      "module": "evolution",
      "name": "Evolution Center",
      "summary": "演进中心内置工作区",
      "workspace_root": "{{process.cwd()}}",
      "sop_bindings": [
        {
          "sop_id": "sop-evolution-stage-cycle",
          "is_default": true,
          "role_bindings": {
            "boss": "opencode-default",
            "evolution-executor": "opencode-default"
          }
        }
      ]
    }
  ]
}
