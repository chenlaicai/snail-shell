{
  "_comment": "Snail Den 配置文件示例。复制为 snail-den.json 并根据实际环境修改。",
  "templates": [
    {
      "id": "claude-code-sonnet",
      "name": "Claude Code + Sonnet",
      "runtime": "claude-code-cli",
      "model": "sonnet",
      "contextWindow": 200000
    },
    {
      "id": "claude-code-stateful-sonnet",
      "name": "Claude Code Stateful + Sonnet",
      "runtime": "claude-code-stateful-cli",
      "model": "claude-sonnet-4-6",
      "contextWindow": 200000
    },
    {
      "id": "opencode-default",
      "name": "OpenCode + GPT-5.5",
      "runtime": "opencode-cli",
      "model": "my-geek/gpt-5.5",
      "contextWindow": 270000
    },
    {
      "id": "codex-opus",
      "name": "Codex + Claude Opus",
      "runtime": "codex-cli",
      "model": "claude-opus-4",
      "contextWindow": 200000
    },
    {
      "id": "gemini-default",
      "name": "Gemini CLI",
      "runtime": "gemini-cli",
      "model": "default",
      "contextWindow": 128000
    }
  ],
  "snails": [
    {
      "name": "Implementation Snail",
      "description": "负责需求讨论、设计取舍、实现、自检、提交 PR，并处理检视意见。",
      "template": "opencode-default",
      "kind": "agent",
      "capability_expectations": ["需求澄清", "设计取舍", "实现", "自检", "PR 交付", "检视意见处理"],
      "working_rules": [
        "需求不清时先和用户讨论并收敛",
        "完成开发后必须自检并提交 PR",
        "具体动作必须服从系统注入的当前 Stage",
        "逐条处理或理性回应检视意见"
      ],
      "preferred_artifact_types": ["pull_request_record", "review_completion_record", "code_change_record", "code_commit"],
      "stage_affinity": [
        { "stage_type": "development", "order": 1 },
        { "stage_type": "review", "order": 1 }
      ]
    },
    {
      "name": "Acceptance Snail",
      "description": "负责对 PR 做对抗性代码检视，并在 PR 上留下可追溯评论。",
      "template": "opencode-default",
      "kind": "agent",
      "capability_expectations": ["代码检视", "风险识别", "边界条件分析", "PR 评论", "复检结论"],
      "working_rules": [
        "以 PR 实际 diff 和上下文为依据",
        "发现的问题必须在 PR 上明确评论",
        "把必要 why 注释缺失视为代码质量问题",
        "修复后必须重新做一次完整检视，覆盖完整 PR diff、相关上下文和回归风险",
        "最终复核没有待处理问题时必须在 PR 上明确回复可等待用户合入的结论"
      ],
      "preferred_artifact_types": ["review_completion_record", "bug_analysis"],
      "stage_affinity": [
        { "stage_type": "review", "order": 2 }
      ]
    }
  ]
}
