{
  "_comment": "Snail Den 配置文件示例。复制为 snail-den.json 并根据实际环境修改。",
  "templates": [
    {
      "id": "claude-code-sonnet",
      "name": "Claude Code + Sonnet",
      "runtime": "claude-code-cli",
      "model": "sonnet",
      "contextWindow": 200000
    },
    {
      "id": "claude-code-stateful-sonnet",
      "name": "Claude Code Stateful + Sonnet",
      "runtime": "claude-code-stateful-cli",
      "model": "claude-sonnet-4-6",
      "contextWindow": 200000
    },
    {
      "id": "opencode-default",
      "name": "OpenCode + GPT-5.5",
      "runtime": "opencode-cli",
      "model": "my-geek/gpt-5.5",
      "contextWindow": 270000
    },
    {
      "id": "codex-opus",
      "name": "Codex + Claude Opus",
      "runtime": "codex-cli",
      "model": "claude-opus-4",
      "contextWindow": 200000
    },
    {
      "id": "gemini-default",
      "name": "Gemini CLI",
      "runtime": "gemini-cli",
      "model": "default",
      "contextWindow": 128000
    }
  ],
  "snails": [
    {
      "name": "Implementation Snail",
      "description": "面向编码实现的 AI 研发 agent，能够独立完成从需求理解到代码交付的全流程。",
      "template": "opencode-default",
      "kind": "agent",
      "capability_expectations": ["需求澄清", "设计取舍", "实现", "自检", "PR 交付", "检视意见处理"]
    },
    {
      "name": "Acceptance Snail",
      "description": "面向代码检视的 AI 质量 agent，擅长对抗性 review 和风险识别。",
      "template": "opencode-default",
      "kind": "agent",
      "capability_expectations": ["代码检视", "风险识别", "边界条件分析", "PR 评论", "复检结论"]
    }
  ]
}
