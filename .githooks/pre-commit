#!/bin/sh

set -e

# 事前硬约束：阻止直接提交到 main/master 分支。
# 开发者必须先创建隔离 worktree，再在 worktree 分支上开发和提交。
branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "错误：禁止直接提交到 $branch 分支。"
  echo "请先创建隔离 worktree（git worktree add 或 EnterWorktree），在 worktree 分支上完成开发后再提交。"
  exit 1
fi

# #3 提醒：当 src/ 文件有变更时，检查是否有对应的 feature 文档更新。
# 不阻塞提交（存在合法不需要更新文档的场景），但提醒开发者确认。
src_changed=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/' | head -1)
doc_changed=$(git diff --cached --name-only --diff-filter=ACMR -- 'docs/issues/' | head -1)
if [ -n "$src_changed" ] && [ -z "$doc_changed" ]; then
  echo "提醒：本次提交包含 src/ 文件变更但未更新 docs/issues/ 文档。"
  echo "请确认是否需要同步更新 issue 文档（checklist #3、#16）。"
fi

npx tsx scripts/check-issue-doc-numbering.ts

npm run check
