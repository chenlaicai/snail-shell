#!/bin/sh

set -e

# 事前硬约束：阻止直接提交到 main/master 分支。
# 研发者必须先创建隔离 worktree，再在 worktree 分支上开发和提交。
branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "错误：禁止直接提交到 $branch 分支。"
  echo "请先创建隔离 worktree（git worktree add 或 EnterWorktree），在 worktree 分支上完成开发后再提交。"
  exit 1
fi

# #3 提醒：当 src/ 文件有变更时，检查是否有对应的 feature 文档更新。
# 不阻塞提交（存在合法不需要更新文档的场景），但提醒研发者确认。
src_changed=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/' | head -1)
doc_changed=$(git diff --cached --name-only --diff-filter=ACMR -- 'docs/features/' | head -1)
if [ -n "$src_changed" ] && [ -z "$doc_changed" ]; then
  echo "提醒：本次提交包含 src/ 文件变更但未更新 docs/features/ 文档。"
  echo "请确认是否需要同步更新 feature 文档（checklist #3、#16）。"
fi

# 事前硬约束：docs/features 文档编号不能冲突。
# 并行分支可能各自创建了相同 FYYYYMMDDNN 编号的文件，合入前需拦截。
new_docs=$(git diff --cached --name-only --diff-filter=ACMR -- 'docs/features/' || true)
if [ -n "$new_docs" ]; then
  conflict=0
  seen=""
  for f in $new_docs; do
    # 提取文件名中的 FYYYYMMDDNN 部分（取前12个字符：F + 8位日期 + 2位序号）
    basename=$(basename "$f")
    prefix=$(echo "$basename" | grep -oE '^F[0-9]{10}' || true)
    if [ -z "$prefix" ]; then
      continue
    fi
    date_dir=$(echo "$prefix" | cut -c2-9)   # YYYYMMDD
    nn=$(echo "$prefix" | cut -c10-11)         # NN

    # 检查暂存区内是否有同序号不同名的文件
    if echo "$seen" | grep -q "^${date_dir}:${nn}$"; then
      echo "错误：docs/features/ 中存在重复编号 F${date_dir}${nn}（暂存区内冲突）。"
      conflict=1
      continue
    fi
    seen="${seen}${date_dir}:${nn}\n"

    # 检查磁盘上是否已有同序号不同名的文件
    dir="docs/features/${date_dir}"
    if [ -d "$dir" ]; then
      count=$(ls "$dir"/F"${date_dir}${nn}"-*.md 2>/dev/null | wc -l)
      if [ "$count" -gt 1 ]; then
        echo "错误：docs/features/ 中存在重复编号 F${date_dir}${nn}。"
        ls "$dir"/F"${date_dir}${nn}"-*.md 2>/dev/null | sed 's/^/  /'
        conflict=1
      fi
    fi
  done
  if [ "$conflict" -eq 1 ]; then
    exit 1
  fi
fi

npm run check
