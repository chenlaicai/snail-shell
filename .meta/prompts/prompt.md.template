  },
  "inject_matched_prompts": false,
  "skill_references": [
    {
      "id": "message-out",
      "mode": "required",
      "reason": "当需要结构化呈现消息内容时，必须使用 message-out skill 生成规范 payload。"
    }
  ],
  "render_mode": "full"
