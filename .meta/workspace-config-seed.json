        "workspace_root": "{{process.cwd()}}"
      },
      "sops": [
        {
          "sop_id": "sop-code-delivery",
          "is_default": true,
          "role_bindings": {
            "designer": "claude-code-opus-4-7",
            "developer": "claude-code-opus-4-7",
            "reviewer": "codex-gpt-5-5",
            "merger": "codex-gpt-5-5"
          }
        }
      ]
    },
    {
      "workspace": {
        "id": "evolution-center",
        "module": "evolution",
        "name": "Evolution Center",
        "summary": "Snail Shell 演进中心治理空间。",
        "workspace_root": "{{process.cwd()}}"
      },
      "sops": [
        {
          "sop_id": "sop-evolution",
          "is_default": true,
          "role_bindings": {
            "evolution-executor": "codex-gpt-5-5"
