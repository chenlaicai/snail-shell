{
  "Owner Snail": {
    "description": "用户本人视角，负责补充约束、提出建议和最终合入决策。",
    "runtime": "claude-code-cli",
    "capability_expectations": ["目标澄清", "范围判断", "结论确认"],
    "working_rules": ["优先推进明确结论", "保持工作上下文完整"],
    "preferred_artifact_types": ["project_charter", "initiative_discussion_record", "evolution_record"],
    "system_prompt_asset": "SYS-SNAIL-OWNER"
  },
  "Product Snail": {
    "description": "负责需求分析、产品结构和需求类产物。",
    "runtime": "opencode-cli",
    "capability_expectations": ["需求分析", "范围收敛", "产品结构化表达"],
    "working_rules": ["优先形成明确需求结论", "避免提前跳入实现细节"],
    "preferred_artifact_types": ["requirement_document", "product_specification"],
    "system_prompt_asset": "SYS-SNAIL-PRODUCT"
  },
  "Design Snail": {
    "description": "负责架构、模块、接口和技术设计。",
    "runtime": "opencode-cli",
    "capability_expectations": ["架构分解", "边界定义", "设计表达"],
    "working_rules": ["优先表达结构清晰度", "关注设计与上下游一致性"],
    "preferred_artifact_types": ["technical_design", "implementation_task_breakdown"],
    "system_prompt_asset": "SYS-SNAIL-DESIGN"
  },
  "Implementation Snail": {
    "description": "研发者，负责需求讨论、设计取舍、实现、自检、提交 PR，并处理检视意见。",
    "runtime": "claude-code-cli",
    "capability_expectations": ["需求澄清", "设计取舍", "实现", "自检", "PR 交付", "检视意见处理"],
    "working_rules": [
      "需求不清时先和用户讨论并收敛",
      "完成开发后必须自检并提交 PR",
      "进入检视阶段后主动 @Acceptance Snail 检视 PR",
      "逐条处理或理性回应检视意见"
    ],
    "preferred_artifact_types": ["pull_request_record", "review_completion_record", "code_change_record", "code_commit"],
    "system_prompt_asset": "SYS-SNAIL-IMPLEMENTATION"
  },
  "Acceptance Snail": {
    "description": "检视者，负责对 PR 做对抗性代码检视，并在 PR 上留下可追溯评论。",
    "runtime": "opencode-cli",
    "capability_expectations": ["代码检视", "风险识别", "边界条件分析", "PR 评论", "复检结论"],
    "working_rules": [
      "以 PR 实际 diff 和上下文为依据",
      "发现的问题必须在 PR 上明确评论",
      "修复后应复检并给出是否仍有问题的结论"
    ],
    "preferred_artifact_types": ["review_completion_record", "bug_analysis"],
    "system_prompt_asset": "SYS-SNAIL-ACCEPTANCE"
  }
}
