#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"

if [ -f "$ROOT_DIR/dist/src/bin/knowledge-doc-pr.js" ]; then
  node "$ROOT_DIR/dist/src/bin/knowledge-doc-pr.js" "$@"
else
  npx tsx "$ROOT_DIR/src/bin/knowledge-doc-pr.ts" "$@"
fi
