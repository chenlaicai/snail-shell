{
  "name": "snail-shell",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "generate-types": "tsx scripts/generate-types.ts",
    "prompt:evaluate": "tsx scripts/run-prompt-evaluations.ts",
    "seed:self-project": "tsx scripts/seed-self-project.ts",
    "build": "npm run generate-types && npm run lint && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npx tsc && node dist/scripts/build-dist.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run test",
    "start": "npm run build && node dist/src/main.js",
    "service:start": "./bin/snail-service start",
    "service:stop": "./bin/snail-service stop",
    "service:restart": "./bin/snail-service restart",
    "service:status": "./bin/snail-service status",
    "test": "npm run build && node dist/scripts/run-tests.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.62.1",
    "better-sqlite3": "^12.9.0",
    "express": "^5.2.1",
    "marked": "^18.0.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.3.0",
    "linkedom": "^0.18.12",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.2"
  }
}
