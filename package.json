    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.3",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "hono": "^4.12.25",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.5",
