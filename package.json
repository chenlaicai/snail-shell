{
  "name": "snail-shell",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "seed:self-workspace": "tsx scripts/seed-self-workspace.ts",
    "test": "vitest run",
    "build": "npm run lint && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npx tsc && npx tsc-alias && npm run build:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run build",
    "start": "npm run build && node dist/src/main.js",
    "web": "vite --config src/web/vite.config.ts",
    "dev:web": "npm run web",
    "build:web": "vite build --config src/web/vite.config.ts",
    "service:start": "./bin/snail-service start",
    "service:stop": "./bin/snail-service stop",
    "service:restart": "./bin/snail-service restart",
    "service:status": "./bin/snail-service status"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@hono/node-server": "^2.0.4",
