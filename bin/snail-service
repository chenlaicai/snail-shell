#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONTROL_SCRIPT="$ROOT_DIR/dist/src/bin/server-control.js"

if [ $# -lt 1 ]; then
  echo "Usage: ./bin/snail-service <command> [--port <port>] [--db-path <path>]" >&2
  exit 1
fi

COMMAND="$1"
shift

cd "$ROOT_DIR"

if [ "$COMMAND" = "start" ] || [ "$COMMAND" = "restart" ] || [ ! -f "$CONTROL_SCRIPT" ]; then
  npm run build >/dev/null
fi

exec node "$CONTROL_SCRIPT" "$COMMAND" "$@"
