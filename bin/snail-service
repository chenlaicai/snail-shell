#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONTROL_SCRIPT="$ROOT_DIR/dist/src/bin/server-control.js"

if [ $# -lt 1 ]; then
  echo "Usage: ./bin/snail-service <command> [--update-main] [--port <port>] [--db-path <path>]" >&2
  exit 1
fi

COMMAND="$1"
shift

UPDATE_MAIN=0
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --update-main)
      UPDATE_MAIN=1
      shift
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

cd "$ROOT_DIR"

if [ "$UPDATE_MAIN" = "1" ]; then
  if [ "$COMMAND" != "restart" ]; then
    echo "--update-main can only be used with restart" >&2
    exit 1
  fi
  git fetch origin main
  git pull --ff-only origin main
fi

if [ "$COMMAND" = "start" ] || [ "$COMMAND" = "restart" ] || [ ! -f "$CONTROL_SCRIPT" ]; then
  npm run build >/dev/null
fi

if [ ${#ARGS[@]} -eq 0 ]; then
  exec node "$CONTROL_SCRIPT" "$COMMAND"
fi

exec node "$CONTROL_SCRIPT" "$COMMAND" "${ARGS[@]}"
