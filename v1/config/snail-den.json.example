{
  "_comment": "Snail Den 配置文件示例。复制为 snail-den.json 并根据实际环境修改。",
  "_contextWindow_note": "contextWindow 为 Snail 的上下文窗口大小配置（单位：token）。如果 agent 运行时返回了 contextWindow 值，将以运行时返回值为准；此配置仅在运行时未返回值时生效。",
  "snails": [
    {
      "id": "claude-code-sonnet",
      "name": "Claude Code + Sonnet",
      "runtime": "claude-code-cli",
      "model": "sonnet",
      "contextWindow": 200000,
      "contextProvider": "shell"
    },
    {
      "id": "claude-code-stateful-sonnet",
      "name": "Claude Code Stateful + Sonnet",
      "runtime": "claude-code-stateful-cli",
      "model": "claude-sonnet-4-6",
      "contextWindow": 200000,
      "contextProvider": "shell"
    },
    {
      "id": "opencode-default",
      "name": "OpenCode + GPT-5.5",
      "runtime": "opencode-cli",
      "model": "my-geek/gpt-5.5",
      "contextWindow": 270000,
      "contextProvider": "shell"
    },
    {
      "id": "codex-opus",
      "name": "Codex + Claude Opus",
      "runtime": "codex-cli",
      "model": "claude-opus-4",
      "contextWindow": 200000,
      "contextProvider": "shell"
    }
  ]
}
